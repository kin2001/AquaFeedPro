  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:device-access": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-device-access.mjs",
    "check:manual-feed": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-manual-feed.mjs",
    "check:monitoring": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-art27-monitoring.mjs",
    "check:button-state": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-button-state.mjs",
    "check:motion": "node ./scripts/check-motion.mjs",
    "check:feed-status": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-feed-status.mjs",
    "check:alerts": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-alerts.mjs",
    "check:error-text": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-error-text.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "private": true
